{
  "name": "aws-share-files",
  "version": "0.20.18",
  "private": false,
  "license": "MIT",
  "scripts": {
    "dev": "yarn increase && next dev -p 6969",
    "build": "yarn run-scripts && next build",
    "start": "next start",
    "lint": "next lint",
    "increase": "npm --no-git-tag-version version patch",
    "run-scripts": "node --experimental-strip-types ./script.runner.node.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "doctor": "react-doctor . --yes --no-telemetry",
    "fallow": "fallow --format compact --fail-on-issues",
    "verify": "yarn lint && yarn typecheck && yarn test && yarn doctor && yarn fallow"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1111.0",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/lib-dynamodb": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@next-auth/dynamodb-adapter": "^3.0.2",
    "dotenv": "^17.4.2",
    "formidable": "^3.5.4",
    "mitt": "^3.0.1",
    "next": "15.5.23",
    "next-auth": "^4.24.15",
    "next-pwa": "^5.6.0",
    "nodemailer": "^9.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "sort-es": "^1.7.18",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/formidable": "^3.5.1",
    "@types/node": "24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv-webpack": "^9.0.0",
    "eslint": "^9.31.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-next": "15.5.23",
    "fallow": "3.16.0",
    "jsdom": "^26.1.0",
    "react-doctor": "0.9.12",
    "ts-node": "^10.9.2",
    "type-fest": "^4.41.0",
    "typescript": "5.8.3",
    "vitest": "^3.2.7"
  },
  "resolutions": {
    "@types/minimatch": "5.1.2"
  }
}
