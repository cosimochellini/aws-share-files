{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // scripts/generate.manifest.node.ts is executed by Node's type stripping, which
    // resolves specifiers literally and therefore needs the .ts extension spelled out.
    // Legal here only because noEmit is set: nothing rewrites the specifier on the way out.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitAny": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.mts",
    "**/*.tsx",
    "./src/**/*.ts",
    "./scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
